{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash",
      "Glob",
      "Grep"
    ]
  },
  "plugins": [
    {
      "name": "supply-chain-pro",
      "path": "./skills/Supply-Chain-Pro"
    },
    {
      "name": "business-analytics-pro",
