# Secrets
.env
.env.local
.env.*.local

# Output (generated deliverables — regenerable)
output/

# Client research and per-engagement memory — local-only filesystem memory,
# never pushed. The agent may create clients/<slug>/ as it works; those
# folders must not leak into the public repo or to other employees.
# Top-level files like clients/README.md remain trackable.
clients/*/

